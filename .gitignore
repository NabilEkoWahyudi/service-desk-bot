# ══════════════════════════════════════════════════════════════════
# .gitignore — IT Help Desk Bot PLN Batam
# ══════════════════════════════════════════════════════════════════

# ── Dependencies ──────────────────────────────────────────────────
node_modules/
jspm_packages/

# ── Environment — JANGAN pernah commit! ──────────────────────────
.env
.env.local
.env.*.local

# ── WhatsApp session (berisi kredensial login WA) ─────────────────
.wwebjs_auth/
.wwebjs_cache/

# ── Data runtime (berisi data pribadi & sesi user) ───────────────
data/

# ── Log files (dirotasi otomatis, tidak perlu di-commit) ─────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Puppeteer / Chrome cache ─────────────────────────────────────
.cache/
.local-chromium/

# ── PDF sementara yang di-generate bot ───────────────────────────
generated_pdfs/

# ── Test & coverage output ───────────────────────────────────────
coverage/
.nyc_output/

# ── Build & dist output ──────────────────────────────────────────
dist/
build/

# ── Sertifikat SSL lokal ─────────────────────────────────────────
*.pem
*.key
*.crt
*.cert

# ── macOS artifacts ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
__MACOSX/

# ── Windows artifacts ────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Linux artifacts ──────────────────────────────────────────────
*~

# ── Editor & IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo

# ── File perencanaan & scratch internal ──────────────────────────
plan.md
*.mmd
test_pdf.js

# -- Config --
ServiceDesk Plus On Premise.postman_collection.json

# ── AI/Editor tools (konfigurasi lokal, tidak perlu di-commit) ───
.eco/
.agents/

# ── Generated assets (di-generate ulang saat deploy) ─────────────
src/assets/