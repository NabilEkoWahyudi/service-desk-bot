# ──────────────────────────────────────────────────────────────
# IT HELP DESK BOT — PLN BATAM — Environment Variables Template
# Salin file ini menjadi .env dan isi nilai yang sesuai.
# JANGAN commit file .env ke git!
# ──────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# WhatsApp Session
WA_SESSION_PATH=./.wwebjs_auth

# Whitelist Nomor WA (pisahkan dengan koma, tanpa spasi, format: 628xxx)
# Kosongkan untuk menerima pesan dari semua nomor (mode development/testing)
# Isi saat production agar hanya pegawai PLN yang bisa menggunakan bot
WA_WHITELIST=

# PDF Output Directory
PDF_OUTPUT_DIR=./generated_pdfs

# ManageEngine ServiceDesk Plus API
# Dapatkan Technician Key dari: Admin > API > Technician Key
PLN_API_KEY=YOUR_TECHNICIAN_KEY_HERE

# Endpoint per kategori request ke ManageEngine ServiceDesk
# Ganti localhost:8080 dengan URL server ManageEngine PLN Batam
ENDPOINT_PASSWORD=ME_BASE_URL/api/v3/requests
ENDPOINT_AUTORISASI=ME_BASE_URL/api/v3/requests
ENDPOINT_KELUHAN=ME_BASE_URL/api/v3/requests
ENDPOINT_VPN=ME_BASE_URL/api/v3/requests

# ─────────────────────────────────────────────────────────────
# Webhook: Balasan Admin → WA Pegawai
# ─────────────────────────────────────────────────────────────
# Secret token untuk mengamankan endpoint POST /webhook/reply
# Isi dengan string acak yang kuat (min. 32 karakter)
# ManageEngine atau admin perlu menyertakan ini di header:
#   Authorization: Bearer <WEBHOOK_SECRET>
# Kosongkan untuk menonaktifkan autentikasi (TIDAK DISARANKAN di production)
WEBHOOK_SECRET=ganti_dengan_secret_yang_kuat_dan_acak_di_sini

# ─────────────────────────────────────────────────────────────
# ManageEngine Field IDs (BUG-2 FIX)
# ─────────────────────────────────────────────────────────────
# ID field di ManageEngine yang digunakan saat membuat tiket.
# Cek ID yang benar di ManageEngine:
#   Group            : Admin → Service Desk → Groups → lihat ID di URL
#   Level            : Admin → Service Desk → Levels → cari "Tier 2 - Request"
#   Service Category : Admin → Service Desk → Service Items → "Manajemen User"
#
# Default sesuai konfigurasi PLN Batam (tidak perlu diisi jika sama):
ME_GROUP_ID=
ME_LEVEL_ID=
ME_SERVICE_CATEGORY_ID=
