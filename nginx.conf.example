# ──────────────────────────────────────────────────────────────
# NGINX CONFIGURATION EXAMPLE — IT Service Desk Bot PLN Batam
# Item 9: limit_req_zone di konteks http (bukan global/server)
# ──────────────────────────────────────────────────────────────
#
# CARA PENGGUNAAN:
# 1. Install NGINX: sudo apt install nginx
# 2. Install Certbot: sudo apt install certbot python3-certbot-nginx
# 3. Dapatkan SSL certificate: sudo certbot --nginx -d yourdomain.plnbatam.com
# 4. Copy konfigurasi ini ke: /etc/nginx/sites-available/helpdesk-bot
# 5. Enable: sudo ln -s /etc/nginx/sites-available/helpdesk-bot /etc/nginx/sites-enabled/
# 6. Test: sudo nginx -t
# 7. Reload: sudo systemctl reload nginx
#
# CATATAN PENTING (Item 9 Best Practice):
# limit_req_zone HARUS berada di dalam konteks http {}, BUKAN di level global.
# Jika diletakkan di luar http {}, NGINX akan menolak konfigurasi dengan error:
#   "limit_req_zone" directive is not allowed here
# File ini adalah include dari /etc/nginx/nginx.conf yang memiliki blok http {}
# — JANGAN tambahkan blok http {} duplikat jika sudah ada di nginx.conf utama.
# ──────────────────────────────────────────────────────────────

# ─── Rate Limiting ──────────────────────────────────────────────────────────
# WAJIB berada di dalam konteks http {} — lihat catatan di atas.
# Gunakan memory zone 10MB ($binary_remote_addr = 7 byte/entry → ~130.000 IP unik).
#
# Zona terpisah untuk endpoint berbeda:
#   api_general : untuk endpoint umum (/health, /wa-status, dll)  → 30 r/m
#   api_webhook  : untuk webhook ManageEngine (/webhook/*)         → 60 r/m
#                  (ManageEngine dapat kirim notif setiap ada update tiket)
limit_req_zone $binary_remote_addr zone=api_general:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=api_webhook:10m rate=60r/m;

# Redirect HTTP → HTTPS
server {
    listen 80;
    server_name bot.plnbatam.com;   # Ganti dengan domain/subdomain kamu

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS Server
server {
    listen 443 ssl;
    server_name bot.plnbatam.com;   # Ganti dengan domain/subdomain kamu

    # SSL Certificate (otomatis diisi oleh Certbot)
    ssl_certificate     /etc/letsencrypt/live/bot.plnbatam.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bot.plnbatam.com/privkey.pem;
    include             /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=31536000" always;

    # ── Webhook ManageEngine (limit lebih longgar: 60 r/m) ─────────────────
    # ManageEngine push notification dapat terjadi setiap ada update tiket.
    # burst=10 nodelay: izinkan lonjakan hingga 10 request tanpa antri.
    location ~ ^/webhook/ {
        limit_req zone=api_webhook burst=10 nodelay;
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ── Endpoint umum (30 r/m) ──────────────────────────────────────────────
    # burst=20 nodelay: izinkan burst wajar tanpa antri.
    location / {
        limit_req zone=api_general burst=20 nodelay;
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Hanya izinkan endpoint /health dan /webhook/* dari luar
    # Endpoint lain diblokir jika perlu (uncomment untuk keamanan ekstra)
    # location ~* ^/((?!health|webhook).)*$ {
    #     deny all;
    # }
}
